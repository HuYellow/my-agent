{
  "name": "@my-agent/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime-kernel": {
      "types": "./dist/runtime-kernel.d.ts",
      "import": "./dist/runtime-kernel.js"
    }
  },
  "bin": {
    "my-agent-core": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build --workspace @my-agent/protocol && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@my-agent/protocol": "file:../protocol",
    "@openai/agents": "^0.8.2",
    "node-pty": "^1.1.0",
    "tsx": "^4.21.0",
    "yaml": "^2.7.1",
    "zod": "^4.0.0"
  }
}
